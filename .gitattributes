# Text: normalize line endings in the repo, check out natively.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf

# ---- Git LFS: every binary asset. Run `git lfs install` once per machine. ----
# Unreal assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Source art and textures
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
